# ====================
# ENVIRONMENT
# ====================
NODE_ENV=development
PORT=3000

# ====================
# DATABASE (Docker Compose - Local)
# ====================
# Use this when running with docker-compose
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/emaily

# Use this when running app locally (outside Docker) but connecting to Docker DB
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/emaily

# ====================
# REDIS (Docker Compose - Local)
# ====================
# Use this when running with docker-compose
REDIS_URL=redis://redis:6379

# Use this when running app locally (outside Docker) but connecting to Docker Redis
# REDIS_URL=redis://localhost:6379

# ====================
# AUTHENTICATION
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=your-32-character-encryption-key

# ====================
# TWILIO (SMS Service)
# ====================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ====================
# GMAIL API
# ====================
GMAIL_CLIENT_ID=your_gmail_client_id
GMAIL_CLIENT_SECRET=your_gmail_client_secret
GMAIL_REDIRECT_URI=http://localhost:3000/auth/gmail/callback

# ====================
# OPENAI
# ====================
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4-turbo-preview

# ====================
# MICROSOFT GRAPH (Optional)
# ====================
# MICROSOFT_CLIENT_ID=your_microsoft_client_id
# MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
# MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# ====================
# LOGGING
# ====================
LOG_LEVEL=debug

# ====================
# RATE LIMITING
# ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ====================
# CORS
# ====================
CORS_ORIGIN=http://localhost:3000
